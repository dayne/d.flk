#!/usr/bin/env bash
# flk-build-rootfs ENGINE IMAGE OVERLAY_DIR OUT.ext4 [EXTRA_MB]
#
# Flattens an OCI image into a bootable ext4 file without root:
# `fakeroot` records file ownership from the tar, and `mkfs.ext4 -d`
# (e2fsprogs >= 1.43) reads it back while populating the filesystem.
#
# It works next to OUT (flk's images dir), never in TMPDIR: /tmp can be a
# small tmpfs in RAM (../enshrouded.flk BUGS.flk.md #1). The export streams
# into tar, so the disk holds the unpacked tree and the ext4 image, never a
# tar file as well.
set -euo pipefail
export PATH="$PATH:/usr/sbin:/sbin"

engine=$1 image=$2 overlay=$3 out=$4 extra_mb=${5:-512}

outdir=$(dirname "$out")
mkdir -p "$outdir"
# A build killed outright leaves its work dir behind: remove those whose
# build is gone (the PID is in the name; builds of other apps may be running).
for old in "$outdir"/.flk-rootfs.*; do
  [[ -d $old ]] || continue
  pid=${old##*/.flk-rootfs.}; pid=${pid%%.*}
  [[ $pid =~ ^[0-9]+$ ]] && ! kill -0 "$pid" 2>/dev/null && rm -rf "$old"
done

# Room for the unpacked tree and the ext4 image (that plus a quarter, plus
# EXTRA_MB), on the disk they're written to. An engine that can't say how
# big the image is skips the check.
if size=$("$engine" image inspect --format '{{.Size}}' "$image" 2>/dev/null) && [[ $size =~ ^[0-9]+$ ]]; then
  need=$(( size * 9 / 4 / 1048576 + extra_mb + 64 ))
  free=$(df -Pm "$outdir" | awk 'NR == 2 { print $4 }')
  if [[ $free =~ ^[0-9]+$ ]] && (( free < need )); then
    echo "flk: not enough space to build the rootfs in $outdir: needs about $((need / 1024 + 1))GB" \
         "(the image is $((size / 1048576))MB unpacked, plus the ext4 image), $((free / 1024))GB free" >&2
    exit 1
  fi
fi

work=$(mktemp -d "$outdir/.flk-rootfs.$$.XXXXXX")
cid=""
cleanup() {
  [[ -n $cid ]] && "$engine" rm -f "$cid" >/dev/null 2>&1 || true
  rm -rf "$work"
}
trap cleanup EXIT

# The trailing command lets `create` work for images with no CMD (scratch etc).
cid=$("$engine" create "$image" /bin/true)

fr=()
if command -v fakeroot >/dev/null; then
  fr=(fakeroot)
else
  echo "flk: WARNING: fakeroot not found; every file in the rootfs will be owned by uid $(id -u)" >&2
fi

# File capabilities are read from the same stream (flk-tar-caps, below).
mkfifo "$work/caps.pipe"
"$(dirname "$0")/flk-tar-caps" "$work/caps.pipe" > "$work/caps.tsv" &
caps_pid=$!

"$engine" export "$cid" | tee "$work/caps.pipe" | ${fr[@]+"${fr[@]}"} bash -euo pipefail -c '
  root=$1 overlay=$2 out=$3 extra=$4 err=$5
  mkdir -p "$root"
  # tar warns about every xattr it can'"'"'t set without root: keep its
  # output for a failure only.
  tar -xpf - -C "$root" --numeric-owner 2>"$err" || { cat "$err" >&2; exit 1; }
  # tar creates files with their final mode, so mode 0000 ones (Fedora'"'"'s
  # /etc/shadow, /etc/gshadow) are unreadable for mkfs.ext4 -d. chmod under
  # fakeroot keeps the mode in the image but the real file readable, so
  # re-apply each one'"'"'s own mode (dirs before their contents: \;).
  find "$root" ! -type l \( ! -perm -u=r -o -type d ! -perm -u=x \) \
    -exec sh -c '"'"'chmod "$(stat -c %a "$1")" "$1"'"'"' _ {} \;
  cp -a "$overlay"/. "$root"/
  # No /bin/sh (scratch, distroless): the static flk-agent is PID 1 instead
  # of init.sh. (-L: an absolute symlink would point at the host here.)
  if [ ! -e "$root/bin/sh" ] && [ ! -L "$root/bin/sh" ]; then
    if [ -x "$root/flk/agent" ]; then
      cp "$root/flk/agent" "$root/flk/init"
      echo "    no /bin/sh in the image: booting it with flk'"'"'s static init"
    else
      echo "flk: the image has no /bin/sh, and there is no flk-agent to boot it with (it needs Go to build; see flk doctor)" >&2
      exit 1
    fi
  fi
  chown -R 0:0 "$root/flk"
  mkdir -p "$root"/{proc,sys,dev,run,tmp,etc}
  chmod 1777 "$root/tmp"
  used=$(du -sm "$root" | cut -f1)
  size=$(( used + used / 4 + extra ))
  rm -f "$out"
  truncate -s "${size}M" "$out"
  mkfs.ext4 -F -q -L flk-root -d "$root" "$out"
  echo "    rootfs: ${used}MB used, ${size}MB image -> $out"
' _ "$work/root" "$overlay" "$out" "$extra_mb" "$work/tar.err"
wait "$caps_pid" || { echo "flk: couldn't read file capabilities from the image" >&2; exit 1; }

# File capabilities (setcap; newuidmap on Arch and Fedora) are xattrs that
# tar can't restore without root, so mkfs.ext4 -d never sees them: write
# them into the image from the export's PAX headers.
n=0
while IFS=$'\t' read -r hex path; do
  printf "$(sed 's/../\\x&/g' <<<"$hex")" > "$work/cap.$n"
  echo "ea_set -f $work/cap.$n \"$path\" security.capability" >> "$work/caps.debugfs"
  n=$((n + 1))
done < "$work/caps.tsv"
if ((n)); then
  # debugfs exits 0 when a command fails: anything past its banner is one
  debugfs -w -f "$work/caps.debugfs" "$out" >/dev/null 2>"$work/caps.err" || true
  if grep -qv '^debugfs [0-9]' "$work/caps.err"; then
    echo "flk: couldn't keep file capabilities:" >&2; cat "$work/caps.err" >&2; exit 1
  fi
  echo "    file capabilities kept on $n file$( ((n == 1)) || echo s)"
fi
