#!/usr/bin/env bash
# flk-logpipe LOG MAX_BYTES: append stdin to LOG; past MAX_BYTES, move it to
# LOG.1 (replacing the previous one) and start a new LOG. flk runs it from
# tmux pipe-pane for each machine's serial console, so a long-running
# machine's log never grows past about 2 x MAX_BYTES. `tail -F` (flk logs)
# follows across the rotation.
set -u
export LC_ALL=C # ${#line} counts bytes
log=$1 max=$2
size=$(stat -c %s "$log" 2>/dev/null || echo 0)
exec 3>>"$log"
while IFS= read -r line || [[ -n $line ]]; do
  printf '%s\n' "$line" >&3
  size=$((size + ${#line} + 1))
  if ((size > max)); then
    exec 3>&-
    mv -f "$log" "$log.1"
    exec 3>>"$log"
    size=0
  fi
done
